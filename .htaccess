# Dar Aïcha Tazarka — redirections 301 (refonte architecture site)
# Anciennes URLs -> nouvelles URLs après restructuration multi-pages

RewriteEngine On

# Une seule adresse : https://daraichatazarka.com (sans www, en HTTPS)
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^(.*)$ https://daraichatazarka.com/$1 [R=301,L]

# /index.html -> / (évite le doublon de la page d'accueil)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
RewriteRule ^index\.html$ https://daraichatazarka.com/ [R=301,L]

# Villa (fusion de 3 anciennes pages en une seule)
RewriteRule ^villa\.html$ https://daraichatazarka.com/villa-tazarka-cap-bon.html [R=301,L]
RewriteRule ^espaces\.html$ https://daraichatazarka.com/villa-tazarka-cap-bon.html [R=301,L]
RewriteRule ^location-saisonniere-cap-bon\.html$ https://daraichatazarka.com/villa-tazarka-cap-bon.html [R=301,L]

# Mariages & événements
RewriteRule ^mariages-evenements-tazarka\.html$ https://daraichatazarka.com/mariage-evenement-villa-cap-bon.html [R=301,L]

# Domaine & oliveraie
RewriteRule ^huile-olive-koroneiki\.html$ https://daraichatazarka.com/domaine-oliveraie-huile-olive-tazarka.html [R=301,L]

# Tazarka & accès
RewriteRule ^region-cap-bon\.html$ https://daraichatazarka.com/tazarka-cap-bon-acces.html [R=301,L]

# Sécurité / performance de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
